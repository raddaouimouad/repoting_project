# Server Port
PORT=3000

# Node Environment (development | production)
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas or production URI)
MONGO_URI=mongodb://127.0.0.1:27017/reporting_db

# JWT Secret Key (generate a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_me_in_production

# Optional: Session Secret
SESSION_SECRET=your_super_secret_session_key_here
